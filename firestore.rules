// firestore.rules — con supporto doppio ruolo collaboratore/leader
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Leader classico legge i suoi collaboratori
      allow read: if isAuth() && resource.data.leaderId == request.auth.uid;

      // Un collaboratore-leader legge anche i propri collaboratori
      allow read: if isAuth() && resource.data.leaderId == request.auth.uid;

      allow create: if isAuth() && request.auth.uid == uid;

      // Proprietario aggiorna tutto TRANNE i campi protetti da Stripe/backend
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(["plan", "subscriptionStatus", "stripeCustomerId",
                   "stripeSubscriptionId", "role"]);

      // Il leader (classico o collaboratore-leader) aggiorna livello e isLeader dei suoi
      allow update: if isAuth() &&
        resource.data.leaderId == request.auth.uid &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(["level", "isLeader", "inviteCode",
                                   "leaderSince", "promotedBy", "promotionTrigger"]);

      match /contacts/{contactId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /teams/{teamId} {
      allow get:   if isAuth();
      allow list:  if isAuth();
      // Sia il leader classico che il collaboratore-leader possono scrivere il proprio team
      allow write: if isAuth() && request.auth.uid == teamId;
    }

    match /stripe_events/{eventId} {
      allow read:  if false;
      allow write: if false;
    }
  }
}
