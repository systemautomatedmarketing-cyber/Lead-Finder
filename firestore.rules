rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }

    match /users/{uid} {
      // Lettura: il proprietario, il suo upline diretto, o qualcuno il cui UID è il leaderId
      allow read: if isAuth() && (
        request.auth.uid == uid ||
        resource.data.leaderId == request.auth.uid
      );

      // Creazione: solo se autenticato e uid coincide
      allow create: if isOwner(uid);

      // Aggiornamento: proprietario su campi non protetti
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(["plan", "subscriptionStatus", "stripeCustomerId",
                   "stripeSubscriptionId", "role"]);

      // Il leader può aggiornare livello e flag isLeader dei suoi collaboratori
      allow update: if isAuth() &&
        resource.data.leaderId == request.auth.uid &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            "level", "isLeader", "inviteCode", "leaderSince",
            "promotedBy", "promotionTrigger"
          ]);

      match /contacts/{contactId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Teams: leggibile da tutti gli autenticati (necessario per ricerca codice invito)
    // Scrivibile solo dal leader del team o dal proprietario
    match /teams/{teamId} {
      allow read:   if isAuth();
      allow write:  if isAuth() && (
        request.auth.uid == teamId ||
        (resource != null && resource.data.leaderId == request.auth.uid)
      );
    }

    // Stripe events: solo backend
    match /stripe_events/{eventId} {
      allow read:  if false;
      allow write: if false;
    }
  }
}
